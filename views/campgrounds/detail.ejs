<% layout("./layouts/boilerplate") %>
<link rel="stylesheet" href="/StyleSheets/starability.css">
<!-- Includes the Mapbox GL JS CSS stylesheet -->
<link href="https://api.mapbox.com/mapbox-gl-js/v3.23.1/mapbox-gl.css" rel="stylesheet">
<!-- Imports the Mapbox GL JS bundle -->

    <h1 class="text-center my-3">
        <%= campground.title %>の詳細ページ
    </h1>
    <hr>
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card mb-3">
            <!-- カルーセル -->
            <div id="CampgroundCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <% campground.Images.forEach((image, i) => { %>
                        <% if (campground.Images.length > 1) { %>
                            <button type="button" data-bs-target="#CampgroundCarousel" data-bs-slide-to="<%= i %>" aria-label="Slide <%= i+1 %>" class="<%= i===0 ? "active" : ""%>"  aria-current="<%= i===0 ? "true" : ""%>"></button>
                        <% } %>
                    <% }) %>
                </div>
            <div class="carousel-inner">
                <% if (!campground.Images || campground.Images.length === 0) { %>
                    <img src="https://res.cloudinary.com/da21pquye/image/upload/v1778382295/YelpCamp/ki68v1o10kumxo4uh3hv.png" class="d-block w-100" alt="">
                <% } %>
                <% campground.Images.forEach((image, i) => { %>
                        <div class="carousel-item <%= i===0 ? "active" : "" %>">
                            <img src="<%= image.url %>" class="d-block w-100" alt="">
                        </div>
                <% }) %>

            </div>
            <% if (campground.Images.length > 1) { %>
                <button class="carousel-control-prev" type="button" data-bs-target="#CampgroundCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#CampgroundCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            <% } %>

            </div>

                
                <div class="card-body">
                    <h5 class="card-title">
                        <%= campground.title %>
                    </h5>
                    <p class="card-text">
                        <%= campground.description %>
                    </p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item text-muted">
                        <%= campground.location %>
                    </li>
                    <li class="list-group-item">￥<%= campground.price %>/泊
                    </li>
                </ul>
                <div class="card-body">
                    <% if (currentUser && currentUser._id.equals(campground.auther._id)) { %>
                        <a href="/campgrounds/<%= campground._id %>/edit" class="card-link btn btn-info">修正</a>
                        <form action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST" class="d-inline ">
                            <button class="btn btn-danger">削除</button>
                        </form>
                    <% } %>
                    
                    <a href="/campgrounds" class="card-link btn btn-primary">一覧へ</a>
                </div>
                <div class="card-body text-muted">
                    登録者：　<%= campground.auther ? campground.auther.username : "unknown" %>
                </div>
            </div>


        </div>
        <!-- レビュー -->
        <div class="col-md-6 mb-5">
            <div id="map" class="detail-map"></div>
            <% if (currentUser) { %>
             <h2>レビューを投稿する</h2>
                <form action="/campgrounds/<%= campground._id %>/reviews" method="POST" novalidate class="needs-validation mb-3">
                    <div>
                        <label for="rating" class="form-label">評価</label>
                    
                        <fieldset class="starability-basic">
                        <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                        <label for="second-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="second-rate2" name="review[rating]" value="2"/>
                        <label for="second-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="second-rate3" name="review[rating]" value="3" checked/>
                        <label for="second-rate3" title="Average">3 stars</label>
                        <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                        <label for="second-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                        <label for="second-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3">
                        <label for="body" class="form-label">コメント</label>
                        <textarea class="form-control" name="review[body]" id="body" row="3" required></textarea>
                        <div class="valid-feedback">
                            OK!
                        </div>
                    </div>
                    <button class="btn btn-success mb-3">投稿する</button>
                </form>
            <% } %>
            
            <h2>レビュー一覧</h2>
            <% if (!campground.reviews.length) { %>
                <div class="mb-3">
                    <p>レビューはありません</p>
                </div>
                <% } else { %>
                    <% for( let review of campground.reviews) { %>
                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title"><%= review.auther ? review.auther.username : "unknown"%></h5>
                                <p class="starability-result" data-rating="<%= review.rating %>">
                                    評価： <%= review.rating %> 
                                </p>
                                <p class="card-text">コメント：<%= review.body %>
                                </p>
                                
                                <% if (currentUser  && currentUser._id.equals(review.auther ? review.auther._id : "")) { %>
                                    <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="d-inline ">
                                        <button class="btn btn-danger">削除</button>
                                    </form>
                                <% } %>
                                

                            </div>

                        </div>

                        <% } %>
                            <% } %>

        </div>
        
    </div>
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.23.1/mapbox-gl.js"></script>
    <script> 
        const mapToken = "<%= process.env.MAPBOX_TOKEN %>" 
        const campground = <%- JSON.stringify(campground) %> 
    </script>
    <script src="/JS/showPageMap.js"></script>